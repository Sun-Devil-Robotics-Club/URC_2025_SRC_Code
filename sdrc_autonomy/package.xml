<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sdrc_autonomy</name>
  <version>0.0.0</version>
  <description>Autonomy package for URC rover missions</description>
  <maintainer email="lamart66@asu.edu">lorenzoam</maintainer>
  <license>Apache 2.0</license>

  <depend>rclpy</depend>
  <depend>nav2_simple_commander</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>vision_opencv</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>utm</exec_depend>
  <depend>ament_cmake</depend>
  <depend>opencv-python</depend>

  <depend>py_trees</depend>
  <depend>std_srvs</depend>


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>